# MongoDB connection string. MongoDB Atlas free-tier cluster, or a local mongod for dev.
# Example Atlas: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/sme_copilot?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sme_copilot

# Name of the database to use (optional if included in MONGODB_URI path)
MONGODB_DB=sme_copilot

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-this-with-a-long-random-string

# OPTIONAL. If unset, the Copilot chat falls back to a keyword-routed responder over the same
# read-only data tools, and the Insights engine (lib/insights.ts) still runs fully with
# deterministic, templated phrasing instead of LLM-composed prose. Nothing in the app breaks
# without this key. Supported: a Gemini API key (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Model to use for the Copilot chat when GEMINI_API_KEY is set.
GEMINI_MODEL=gemini-3.6-flash

# Base URL of the deployed app (used for absolute links in emails/PDFs). For local dev, leave as-is.
NEXT_PUBLIC_APP_URL=http://localhost:3000
